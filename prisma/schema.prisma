generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Folder {
  id        String      @id @default(cuid()) @db.VarChar(191)
  userId    String      @db.VarChar(191)
  name      String      @db.VarChar(120)
  parentId  String?     @db.VarChar(191)
  isVisible Boolean     @default(true)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Folder?     @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]    @relation("FolderHierarchy")
  routes    RoutePlan[]

  @@index([userId])
  @@index([userId, parentId])
  @@index([parentId])
  @@map("folders")
}

model RoutePlan {
  id          String       @id @default(cuid()) @db.VarChar(191)
  userId      String       @db.VarChar(191)
  folderId    String?      @db.VarChar(191)
  name        String       @db.VarChar(120)
  description String?      @db.Text
  color       String       @default("#1677ff") @db.VarChar(16)
  isVisible   Boolean      @default(true)
  pointsJson  Json?
  mapLng      Float?
  mapLat      Float?
  mapZoom     Float?
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder      Folder?      @relation(fields: [folderId], references: [id], onDelete: Cascade)
  points      RoutePoint[]

  @@index([userId])
  @@index([userId, folderId])
  @@index([folderId])
  @@map("route_plans")
}

model RoutePoint {
  id          String    @id @default(cuid()) @db.VarChar(191)
  routePlanId String    @db.VarChar(191)
  lng         Float
  lat         Float
  name        String?   @db.VarChar(120)
  note        String?   @db.Text
  orderIndex  Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  routePlan   RoutePlan @relation(fields: [routePlanId], references: [id], onDelete: Cascade)

  @@index([routePlanId, orderIndex])
  @@map("route_points")
}

model User {
  id           String        @id @default(cuid()) @db.VarChar(191)
  username     String        @unique @db.VarChar(80)
  displayName  String?       @db.VarChar(120)
  passwordHash String        @db.VarChar(255)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     AuthSession[]
  folders      Folder[]
  routes       RoutePlan[]

  @@map("users")
}

model AuthSession {
  id        String   @id @default(cuid()) @db.VarChar(191)
  userId    String   @db.VarChar(191)
  tokenHash String   @unique @db.VarChar(191)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}
